# Production Environment Variables for Vercel
# Copy these values to Vercel Dashboard > Settings > Environment Variables

# API Backend URL (Production)
NEXT_PUBLIC_API_URL=https://api.monpetitbiz.com

# Backend Service Token (Production)
# ⚠️ Generate a unique token for production
BACKEND_SERVICE_TOKEN=your_production_backend_token_here

# JWT Secret (CRITICAL FOR SECURITY)
# ⚠️ NEVER reuse development secrets in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_a_new_32_byte_hex_secret_here

# Database Configuration
DATABASE_TYPE=neon

# Neon PostgreSQL Connection String
# Format: postgresql://user:password@host.region.aws.neon.tech/database?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-1.aws.neon.tech/database?sslmode=require

# ========================================
# INSTRUCTIONS:
# ========================================
# 
# 1. Generate new secrets (NEVER reuse development secrets):
#    JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    BACKEND_SERVICE_TOKEN: Use your backend's production token
#
# 2. In Vercel Dashboard:
#    - Go to Settings > Environment Variables
#    - Add each variable above
#    - Select "Production" environment
#    - Click "Save"
#
# 3. Redeploy:
#    vercel --prod
#
# 4. Verify:
#    - Check Vercel deployment logs
#    - Test login on production URL
#    - Monitor security logs
#
# ========================================
