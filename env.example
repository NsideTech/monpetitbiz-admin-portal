# API Backend URL
# For development: http://localhost:9000
# For production: https://api.monpetitbiz.com
NEXT_PUBLIC_API_URL=http://localhost:9000

# Backend Service Token
# Token de service/admin pour authentifier les requêtes vers le backend MonPetitBiz
# Ce token doit correspondre EXACTEMENT à la variable SERVICE_TOKEN configurée dans le backend
# IMPORTANT: Ne jamais exposer ce token au client, il est uniquement utilisé côté serveur
# 
# Pour configurer :
# 1. Définissez SERVICE_TOKEN dans le backend (ex: dans .env du backend)
# 2. Utilisez la même valeur ici dans BACKEND_SERVICE_TOKEN
# 3. Exemple: BACKEND_SERVICE_TOKEN=my-secret-service-token-12345
BACKEND_SERVICE_TOKEN=your_backend_service_token_here

# Database Configuration
# Options: 'sqlite' (for local development) or 'supabase' (for production)
# Defaults to 'sqlite' in development, 'supabase' in production
DATABASE_TYPE=sqlite

# Supabase Configuration (ONLY required if DATABASE_TYPE=supabase)
# Leave empty or comment out if using SQLite (local development)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Note: Statistics are retrieved from the backend via API
# No database configuration needed for statistics

