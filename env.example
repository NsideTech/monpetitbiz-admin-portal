# API Backend URL
# For development: http://localhost:9000
# For production: https://api.monpetitbiz.com
NEXT_PUBLIC_API_URL=http://localhost:9000

# JWT Secret for Session Tokens (REQUIRED - CRITICAL FOR SECURITY)
# This secret is used to sign and verify user session tokens
# Generate a strong random secret with at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Keep this secret safe and NEVER commit it to git
# IMPORTANT: Use a different secret for each environment (dev, staging, production)
JWT_SECRET=generate_a_strong_random_secret_at_least_32_characters_long

# Backend Service Token
# Token de service/admin pour authentifier les requêtes vers le backend MonPetitBiz
# Ce token doit correspondre EXACTEMENT à la variable SERVICE_TOKEN configurée dans le backend
# IMPORTANT: Ne jamais exposer ce token au client, il est uniquement utilisé côté serveur
# 
# Pour configurer :
# 1. Définissez SERVICE_TOKEN dans le backend (ex: dans .env du backend)
# 2. Utilisez la même valeur ici dans BACKEND_SERVICE_TOKEN
# 3. Exemple: BACKEND_SERVICE_TOKEN=my-secret-service-token-12345
BACKEND_SERVICE_TOKEN=your_backend_service_token_here

# Database Configuration
# Options: 'sqlite' (for local development), 'neon' (for production), or 'supabase' (legacy)
# Defaults to 'sqlite' in development, 'neon' in production
DATABASE_TYPE=sqlite

# Neon Configuration (ONLY required if DATABASE_TYPE=neon)
# Leave empty or comment out if using SQLite (local development)
# Get your connection string from your Neon project dashboard
# DATABASE_URL=postgres://user:password@host.neon.tech/database?sslmode=require

# Supabase Configuration (ONLY required if DATABASE_TYPE=supabase - legacy support)
# Leave empty or comment out if using SQLite or Neon
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Note: Statistics are retrieved from the backend via API
# No database configuration needed for statistics

